{
  "name": "@shotbook/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "content": "node scripts/bundle-content.mts",
    "start": "pnpm content && expo start --go",
    "start:dev-client": "pnpm content && expo start --dev-client",
    "ios": "pnpm content && expo start --go --ios",
    "android": "pnpm content && expo start --go --android",
    "typecheck": "pnpm content && tsc --noEmit && tsc --noEmit -p scripts",
    "eas-build-post-install": "pnpm content"
  },
  "dependencies": {
    "@expo-google-fonts/jost": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@shotbook/content": "workspace:*",
    "@shotbook/shot-viz": "workspace:*",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3",
    "@types/node": "^24.0.0"
  }
}
