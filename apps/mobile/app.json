{
  "expo": {
    "name": "Shotbook",
    "slug": "shotbook",
    "scheme": "shotbook",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "app.shotbook.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.shotbook.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#1b201e"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "797043cd-682a-4755-9e38-3db2b8e1d3f8"
      }
    },
    "owner": "shotbooks-team"
  }
}
