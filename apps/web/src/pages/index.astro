---
import { CATEGORIES } from "@shotbook/content";
import Handed from "../components/Handed.astro";
import SearchBox from "../components/SearchBox.astro";
import SituationList from "../components/SituationList.astro";
import Base from "../layouts/Base.astro";
import {
  commonSituations,
  getSituations,
  getTags,
  href,
  situationsIn,
  tagLabel,
} from "../lib/content";

const situations = getSituations();
const common = commonSituations();
const tags = getTags().slice(0, 12);
// Elevation rings, like the contours on a green in a yardage book: [rx, ry, rotation].
const contours = [
  [150, 112, -20],
  [122, 90, -16],
  [96, 70, -12],
  [72, 52, -8],
  [50, 36, -4],
  [30, 22, 0],
  [13, 10, 4],
];
---

<Base>
  <section class="relative">
    <svg
      aria-hidden="true"
      viewBox="0 0 360 280"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      class="pointer-events-none absolute -top-10 -right-36 h-70 w-90 text-accent opacity-15 sm:-right-16"
    >
      {contours.map(([rx, ry, angle], i) => (
        <ellipse
          cx={180 + i * 4}
          cy={140 - i * 2}
          rx={rx}
          ry={ry}
          transform={`rotate(${angle} 180 140)`}
        />
      ))}
    </svg>
    <div class="relative">
      <h1 class="max-w-sm pt-6 font-serif text-4xl leading-tight font-bold tracking-tight text-ink-strong">
        How do I play this shot?
      </h1>
      <p class="mt-3 text-lg text-ink-muted">
        Short, practical advice for awkward lies, tricky conditions and nervy moments — readable
        between shots.
      </p>

      <div class="mt-6">
        <SearchBox />
      </div>
    </div>
  </section>

  {common.length > 0 && (
    <>
      <h2 class="mt-8 mb-3 text-xl font-semibold text-ink-strong">Common situations</h2>
      <ul class="flex flex-wrap gap-2">
        {common.map((s) => (
          <li>
            <a
              href={href(`situations/${s.id}/`)}
              class="inline-flex min-h-11 items-center rounded-full bg-accent-soft px-4 font-medium text-accent-strong transition-colors hover:bg-accent hover:text-on-accent"
            >
              <Handed text={s.title} />
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2 class="mt-8 mb-3 text-xl font-semibold text-ink-strong">Browse by category</h2>
  <ul class="grid grid-cols-2 gap-3">
    {CATEGORIES.map((c) => {
      const count = situationsIn(c.id).length;
      return (
        <li>
          <a
            href={href(`category/${c.id}/`)}
            class="flex h-full min-h-20 flex-col justify-between rounded-card border border-line bg-card p-3 shadow-card transition hover:border-accent active:bg-accent-soft"
          >
            <span class="font-semibold text-ink-strong">{c.title}</span>
            <span class="text-sm text-ink-muted">
              {count === 1 ? "1 situation" : `${count} situations`}
            </span>
          </a>
        </li>
      );
    })}
  </ul>

  <h2 class="mt-8 mb-3 text-xl font-semibold text-ink-strong">Browse by tag</h2>
  <ul class="flex flex-wrap gap-2">
    {tags.map(({ tag }) => (
      <li>
        <a
          href={href(`tags/${tag}/`)}
          class="inline-flex min-h-11 items-center rounded-full bg-surface px-4 font-medium text-ink transition-colors hover:bg-accent-soft hover:text-accent-strong"
        >
          {tagLabel(tag)}
        </a>
      </li>
    ))}
    <li>
      <a
        href={href("tags/")}
        class="inline-flex min-h-11 items-center px-2 font-medium text-accent underline"
      >
        All tags
      </a>
    </li>
  </ul>

  <h2 id="all" class="mt-8 mb-3 text-xl font-semibold text-ink-strong">
    All situations
  </h2>
  {situations.length > 0 ? (
    <SituationList situations={situations} />
  ) : (
    <p class="rounded-card bg-card p-4 text-ink-muted">No situations yet — they're on the way.</p>
  )}
</Base>
