---
import { CATEGORIES } from "@shotbook/content";
import Handed from "../components/Handed.astro";
import SearchBox from "../components/SearchBox.astro";
import SituationList from "../components/SituationList.astro";
import Base from "../layouts/Base.astro";
import {
  commonSituations,
  getSituations,
  getTags,
  href,
  situationsIn,
  tagLabel,
} from "../lib/content";

const situations = getSituations();
const common = commonSituations();
const tags = getTags().slice(0, 12);
---

<Base>
  <h1 class="text-3xl font-extrabold tracking-tight text-fairway-900">How do I play this shot?</h1>
  <p class="mt-2 text-lg text-stone-700">
    Short, practical advice for awkward lies, tricky conditions and nervy moments — readable between
    shots.
  </p>

  <div class="mt-6">
    <SearchBox />
  </div>

  {common.length > 0 && (
    <>
      <h2 class="mt-8 mb-3 text-xl font-bold">Common situations</h2>
      <ul class="flex flex-wrap gap-2">
        {common.map((s) => (
          <li>
            <a
              href={href(`situations/${s.id}/`)}
              class="inline-flex min-h-11 items-center rounded-full border border-fairway-600 bg-white px-4 font-medium text-fairway-800 hover:bg-fairway-50"
            >
              <Handed text={s.title} />
            </a>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2 class="mt-8 mb-3 text-xl font-bold">Browse by category</h2>
  <ul class="grid grid-cols-2 gap-3">
    {CATEGORIES.map((c) => {
      const count = situationsIn(c.id).length;
      return (
        <li>
          <a
            href={href(`category/${c.id}/`)}
            class="flex h-full min-h-20 flex-col justify-between rounded-2xl border border-stone-300 bg-white p-3 shadow-sm transition hover:border-fairway-600 active:bg-fairway-50"
          >
            <span class="font-semibold text-fairway-800">{c.title}</span>
            <span class="text-sm text-stone-600">
              {count === 1 ? "1 situation" : `${count} situations`}
            </span>
          </a>
        </li>
      );
    })}
  </ul>

  <h2 class="mt-8 mb-3 text-xl font-bold">Browse by tag</h2>
  <ul class="flex flex-wrap gap-2">
    {tags.map(({ tag }) => (
      <li>
        <a
          href={href(`tags/${tag}/`)}
          class="inline-flex min-h-11 items-center rounded-full bg-stone-200 px-4 font-medium text-stone-800 hover:bg-stone-300"
        >
          {tagLabel(tag)}
        </a>
      </li>
    ))}
    <li>
      <a
        href={href("tags/")}
        class="inline-flex min-h-11 items-center px-2 font-medium text-fairway-700 underline"
      >
        All tags
      </a>
    </li>
  </ul>

  <h2 id="all" class="mt-8 mb-3 text-xl font-bold">
    All situations
  </h2>
  {situations.length > 0 ? (
    <SituationList situations={situations} />
  ) : (
    <p class="rounded-2xl bg-white p-4 text-stone-700">No situations yet — they're on the way.</p>
  )}
</Base>
