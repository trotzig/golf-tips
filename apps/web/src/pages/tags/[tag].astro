---
import type { Situation } from "@shotbook/content";
import SituationList from "../../components/SituationList.astro";
import Base from "../../layouts/Base.astro";
import { getTags, href, tagLabel } from "../../lib/content";

export function getStaticPaths() {
  return getTags().map(({ tag, situations }) => ({ params: { tag }, props: { tag, situations } }));
}

interface Props {
  tag: string;
  situations: Situation[];
}

const { tag, situations } = Astro.props;
const label = tagLabel(tag);
---

<Base title={label} description={`Golf situations tagged “${label.toLowerCase()}”.`}>
  <nav aria-label="Breadcrumb" class="mb-3">
    <a href={href("tags/")} class="inline-block py-2 font-medium text-fairway-700 underline">
      ← All tags
    </a>
  </nav>
  <h1 class="text-3xl font-extrabold tracking-tight text-fairway-900">{label}</h1>
  <p class="mt-2 mb-6 text-lg text-stone-700">
    {situations.length === 1 ? "1 situation" : `${situations.length} situations`}
  </p>
  <SituationList situations={situations} />
</Base>
