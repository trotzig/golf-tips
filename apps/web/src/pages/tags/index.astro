---
import Base from "../../layouts/Base.astro";
import { getTags, href, tagLabel } from "../../lib/content";

const tags = getTags();
---

<Base title="Tags" description="Browse golf situations by topic.">
  <nav aria-label="Breadcrumb" class="mb-3">
    <a href={href("/")} class="inline-block py-2 font-medium text-accent underline">
      ← Home
    </a>
  </nav>
  <h1 class="mb-6 text-3xl font-serif font-bold tracking-tight text-ink-strong">Browse by tag</h1>
  <ul class="flex flex-wrap gap-2">
    {tags.map(({ tag, situations }) => (
      <li>
        <a
          href={href(`tags/${tag}/`)}
          class="inline-flex min-h-11 items-center gap-2 rounded-full bg-accent-soft px-4 font-medium text-accent-strong transition-colors hover:bg-accent hover:text-on-accent"
        >
          {tagLabel(tag)}
          <span class="text-sm text-ink-muted">{situations.length}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
