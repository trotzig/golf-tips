---
import { getCategory, type Situation } from "@shotbook/content";
import { marked } from "marked";
import Bullets from "../../components/Bullets.astro";
import Card from "../../components/Card.astro";
import Handed from "../../components/Handed.astro";
import ShotViz from "../../components/ShotViz.astro";
import Base from "../../layouts/Base.astro";
import { getSituations, href, tagLabel } from "../../lib/content";
import { handedMarkdown } from "../../lib/handed";

export function getStaticPaths() {
  return getSituations().map((situation) => ({
    params: { id: situation.id },
    props: { situation },
  }));
}

interface Props {
  situation: Situation;
}

const { situation: s } = Astro.props;
const category = getCategory(s.category);
const byId = new Map(getSituations().map((x) => [x.id, x]));
const related = s.related.flatMap((id) => byId.get(id) ?? []);
// Body is trusted Markdown from the repo.
const bodyHtml = s.body ? await marked.parse(handedMarkdown(s.body)) : "";
const levelLabel = { all: "All levels", beginner: "Beginner", advanced: "Advanced" }[s.level];
---

<Base title={s.title} description={s.summary} image={`og/situations/${s.id}.png`} type="article">
  <nav aria-label="Breadcrumb" class="mb-3">
    <a
      href={href(`category/${category.id}/`)}
      class="inline-block py-2 font-medium text-accent underline"
    >
      ← {category.title}
    </a>
  </nav>

  <article class="space-y-4">
    <header>
      <h1 class="text-3xl font-serif font-bold tracking-tight text-ink-strong">
        <Handed text={s.title} />
      </h1>
      <p class="mt-2 text-xl text-ink">
        <Handed text={s.summary} />
      </p>
      <ul class="mt-3 flex flex-wrap gap-2 text-sm font-medium" aria-label="Applies to">
        <li class="rounded-full bg-accent-soft px-3 py-1 text-accent-strong">{levelLabel}</li>
        {s.clubs?.map((club) => (
          <li class="rounded-full bg-surface px-3 py-1 capitalize text-ink">{club}</li>
        ))}
      </ul>
    </header>

    <ShotViz viz={s.viz} />

    {s.setup && (
      <Card title="Setup">
        <Bullets items={s.setup} />
      </Card>
    )}
    {s.swing && (
      <Card title="Swing">
        <Bullets items={s.swing} />
      </Card>
    )}
    <Card title="What to expect">
      <Bullets items={s.expect} />
    </Card>
    {s.club_choice && (
      <Card title="Club choice">
        <p>
          <Handed text={s.club_choice} />
        </p>
      </Card>
    )}
    {s.mistakes && (
      <Card title="Common mistakes" tone="warning">
        <Bullets items={s.mistakes} />
      </Card>
    )}
    {s.drill && (
      <Card title="Practice drill" tone="muted">
        <p>
          <Handed text={s.drill} />
        </p>
      </Card>
    )}
    {s.advanced && (
      <Card title="For better players" tone="muted">
        <p>
          <Handed text={s.advanced} />
        </p>
      </Card>
    )}
    {bodyHtml && <section class="space-y-3 px-1 text-lg text-ink" set:html={bodyHtml} />}

    {related.length > 0 && (
      <section>
        <h2 class="mb-2 text-xs font-semibold uppercase tracking-widest text-ink-muted">Related</h2>
        <ul class="flex flex-wrap gap-2">
          {related.map((r) => (
            <li>
              <a
                href={href(`situations/${r.id}/`)}
                class="inline-block rounded-full bg-accent-soft px-4 py-2 font-medium text-accent-strong transition-colors hover:bg-accent hover:text-on-accent"
              >
                <Handed text={r.title} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section>
      <h2 class="mb-2 text-xs font-semibold uppercase tracking-widest text-ink-muted">Tags</h2>
      <ul class="flex flex-wrap gap-2">
        {s.tags.map((tag) => (
          <li>
            <a
              href={href(`tags/${tag}/`)}
              class="inline-block rounded-full bg-surface px-4 py-2 font-medium text-ink transition-colors hover:bg-accent-soft hover:text-accent-strong"
            >
              {tagLabel(tag)}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <footer class="text-sm text-ink-muted">
      Updated <time datetime={s.updated}>{s.updated}</time>
    </footer>
  </article>
</Base>
