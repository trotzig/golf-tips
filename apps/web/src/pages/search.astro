---
import SearchBox from "../components/SearchBox.astro";
import SituationList from "../components/SituationList.astro";
import Base from "../layouts/Base.astro";
import { getSituations } from "../lib/content";
---

<Base title="Search" description="Search every golf situation by name, symptom or keyword.">
  <h1 class="mb-4 text-3xl font-serif font-bold tracking-tight text-ink-strong">Search</h1>
  <SearchBox autofocus />
  <section data-search-fallback class="mt-8">
    <h2 class="mb-3 text-xl font-semibold text-ink-strong">All situations</h2>
    <noscript>
      <p class="mb-3 text-ink-muted">
        Instant search needs JavaScript. Every situation is listed below — use your browser's
        find-in-page to jump to one.
      </p>
    </noscript>
    <SituationList situations={getSituations()} />
  </section>
</Base>
