---
// Address position at a glance, drawn from the situation's scene and compared with a normal shot
// with the same club (dashed). Seen as the golfer looks down at the ball, so the lead foot is on
// the left for a right-hander; both hands are drawn and global.css shows the reader's.
import { setupInsight, type ShotScene } from "@shotbook/shot-viz";
import Handed from "./Handed.astro";

interface Props {
  scene: ShotScene;
}

const { scene } = Astro.props;
const i = setupInsight(scene);
const { setup, normal } = i;

const ballText = { less: "Back of normal", normal: "Normal", more: "Forward of normal" }[
  i.ballPosition
];
const weightText = { lead: "More on lead foot", even: "Even", trail: "More on trail foot" }[
  i.weight
];
const shoulderText = i.matchesSlope
  ? "Match the slope"
  : setup.shoulderTilt > 7
    ? "Lead shoulder higher"
    : setup.shoulderTilt >= 2
      ? "Lead side a touch higher"
      : "Level";
const stanceText = { narrow: "Narrow", normal: "Normal", wide: "Wide" }[i.stance];
const aimText =
  Math.abs(i.aim) < 1 ? "At the target" : i.aim < 0 ? "A little {left}" : "A little {right}";

const hands = [
  { cls: "hand-r", mirror: false },
  { cls: "hand-l", mirror: true },
];
const r = (n: number) => Math.round(n * 10) / 10;

// Ball position: −1 trail foot … 1 lead heel. The lead foot is on the left unless mirrored.
const ballX = (v: number, mirror: boolean) => r(150 + (mirror ? v : -v) * 92);
const leadFootX = (mirror: boolean) => (mirror ? 252 : 48);
const trailFootX = (mirror: boolean) => (mirror ? 48 : 252);

// Weight bar fills from the lead side.
const weightW = r(128 * setup.weightLead);

// Shoulders over the ground, lead side on the left unless mirrored.
const line = (deg: number, len: number, cy: number, mirror: boolean) => {
  const dx = Math.cos((deg * Math.PI) / 180) * len;
  const dy = Math.sin((deg * Math.PI) / 180) * len;
  const lead = mirror ? 1 : -1;
  return { x1: r(65 + lead * dx), y1: r(cy - dy), x2: r(65 - lead * dx), y2: r(cy + dy) };
};

const stanceHalf = (w: number) => r(w * 120);
const aimRad = (mirror: boolean) => ((mirror ? -i.aim : i.aim) * 3 * Math.PI) / 180;
---

<div class="mb-4">
  <p class="mb-2 text-sm text-ink-muted">As you look down at the ball. Dashed: a normal shot.</p>
  <div class="grid grid-cols-2 gap-2.5">
    <div class="col-span-2 rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Ball position</h3>
      <p class="font-semibold text-ink-strong">{ballText}</p>
      {hands.map(({ cls, mirror }) => (
        <svg class={`${cls} mt-1 h-auto w-full align-top`} viewBox="0 0 300 66" aria-hidden="true">
          <ellipse
            cx={leadFootX(mirror)}
            cy="32"
            rx="13"
            ry="22"
            class="fill-card stroke-line-strong"
            stroke-width="1.5"
          />
          <ellipse
            cx={trailFootX(mirror)}
            cy="32"
            rx="13"
            ry="22"
            class="fill-card stroke-line-strong"
            stroke-width="1.5"
          />
          <line
            x1="66"
            y1="32"
            x2="234"
            y2="32"
            class="stroke-line-strong"
            stroke-width="1.5"
            stroke-dasharray="2 4"
          />
          <circle
            cx={ballX(normal.ballPosition, mirror)}
            cy="32"
            r="8"
            fill="none"
            class="stroke-line-strong"
            stroke-width="1.6"
            stroke-dasharray="3 2"
          />
          <circle
            cx={ballX(setup.ballPosition, mirror)}
            cy="32"
            r="8"
            class="fill-card stroke-ink-strong"
            stroke-width="2"
          />
          <text
            x={leadFootX(mirror)}
            y="64"
            text-anchor="middle"
            font-size="11"
            class="fill-ink-muted"
          >
            Lead
          </text>
          <text
            x={trailFootX(mirror)}
            y="64"
            text-anchor="middle"
            font-size="11"
            class="fill-ink-muted"
          >
            Trail
          </text>
          <text
            x={mirror ? 298 : 2}
            y="11"
            text-anchor={mirror ? "end" : "start"}
            font-size="11"
            font-weight="600"
            class="fill-accent"
          >
            {mirror ? "Target →" : "← Target"}
          </text>
        </svg>
      ))}
    </div>

    <div class="rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Weight</h3>
      <p class="leading-tight font-semibold text-ink-strong">{weightText}</p>
      {hands.map(({ cls, mirror }) => (
        <svg
          class={`${cls} mt-1.5 h-auto w-full align-top`}
          viewBox="0 0 130 40"
          aria-hidden="true"
        >
          <rect
            x="1"
            y="8"
            width="128"
            height="16"
            rx="8"
            class="fill-card stroke-line-strong"
            stroke-width="1"
          />
          <rect
            x={mirror ? r(129 - weightW) : 1}
            y="8"
            width={weightW}
            height="16"
            rx="8"
            class="fill-accent"
          />
          <line
            x1="65"
            y1="4"
            x2="65"
            y2="28"
            class="stroke-ink-strong"
            stroke-width="1.5"
            stroke-dasharray="2 2"
          />
          <text x="2" y="38" font-size="10" class="fill-ink-muted">
            {mirror ? "Trail" : "Lead"}
          </text>
          <text x="128" y="38" font-size="10" text-anchor="end" class="fill-ink-muted">
            {mirror ? "Lead" : "Trail"}
          </text>
        </svg>
      ))}
    </div>

    <div class="rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Shoulders</h3>
      <p class="leading-tight font-semibold text-ink-strong">{shoulderText}</p>
      {hands.map(({ cls, mirror }) => {
        const ground = line(scene.terrain.slopeAlong, 62, 44, mirror);
        const sh = line(setup.shoulderTilt, 46, 20, mirror);
        return (
          <svg
            class={`${cls} mt-1.5 h-auto w-full align-top`}
            viewBox="0 0 130 56"
            aria-hidden="true"
          >
            <line {...ground} class="stroke-line-strong" stroke-width="5" stroke-linecap="round" />
            <line {...sh} class="stroke-accent" stroke-width="3" stroke-linecap="round" />
            <circle cx={sh.x1} cy={sh.y1} r="4" class="fill-accent" />
            <circle cx={sh.x2} cy={sh.y2} r="4" class="fill-accent" />
            <text x={sh.x1} y={sh.y1 - 8} font-size="9" text-anchor="middle" class="fill-ink-muted">
              lead
            </text>
          </svg>
        );
      })}
    </div>

    <div class="rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Stance</h3>
      <p class="leading-tight font-semibold text-ink-strong">{stanceText}</p>
      <svg class="mt-1.5 block h-auto w-full" viewBox="0 0 130 36" aria-hidden="true">
        <rect
          x={65 - stanceHalf(normal.stanceWidth) - 6}
          y="6"
          width="12"
          height="24"
          rx="6"
          fill="none"
          class="stroke-line-strong"
          stroke-width="1.4"
          stroke-dasharray="3 2"
        />
        <rect
          x={65 + stanceHalf(normal.stanceWidth) - 6}
          y="6"
          width="12"
          height="24"
          rx="6"
          fill="none"
          class="stroke-line-strong"
          stroke-width="1.4"
          stroke-dasharray="3 2"
        />
        <rect
          x={65 - stanceHalf(setup.stanceWidth) - 6}
          y="6"
          width="12"
          height="24"
          rx="6"
          class="fill-ink-strong"
        />
        <rect
          x={65 + stanceHalf(setup.stanceWidth) - 6}
          y="6"
          width="12"
          height="24"
          rx="6"
          class="fill-ink-strong"
        />
      </svg>
    </div>

    <div class="rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Aim</h3>
      <p class="leading-tight font-semibold text-ink-strong">
        <Handed text={aimText} />
      </p>
      {hands.map(({ cls, mirror }) => {
        const a = aimRad(mirror);
        const x2 = r(65 + Math.sin(a) * 28);
        const y2 = r(34 - Math.cos(a) * 28);
        return (
          <svg
            class={`${cls} mt-1.5 h-auto w-full align-top`}
            viewBox="0 0 130 38"
            aria-hidden="true"
          >
            <line
              x1="65"
              y1="34"
              x2="65"
              y2="4"
              class="stroke-line-strong"
              stroke-width="1.4"
              stroke-dasharray="2 3"
            />
            <circle cx="65" cy="4" r="3" class="fill-highlight" />
            <line
              x1="65"
              y1="34"
              x2={x2}
              y2={y2}
              class="stroke-accent"
              stroke-width="2.6"
              stroke-linecap="round"
            />
            <circle cx={x2} cy={y2} r="3.5" class="fill-accent" />
          </svg>
        );
      })}
    </div>
  </div>
</div>
