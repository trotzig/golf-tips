---
// Address position at a glance, drawn from the situation's scene and compared with a normal shot
// with the same club (dashed). Every gauge uses the golfer's own view: feet seen from above with
// the ball in front of them, so the lead side and the target are on the
// left for a right-hander and on the right for a left-hander. Both hands are drawn and global.css
// shows the reader's. Ball position, weight and stance share one figure (`addressLayout`, also
// drawn by the app and the shot-viz address playground).
import {
  ADDRESS_H,
  ADDRESS_W,
  addressLayout,
  addressSummary,
  footPath as foot,
  setupInsight,
  type ShotScene,
} from "@shotbook/shot-viz";
import Handed from "./Handed.astro";

interface Props {
  scene: ShotScene;
}

const { scene } = Astro.props;
const i = setupInsight(scene);
const { setup } = i;

const addressText = addressSummary(i);
const shoulderText = i.matchesSlope
  ? "Match the slope"
  : setup.shoulderTilt > 7
    ? "Lead shoulder higher"
    : setup.shoulderTilt >= 2
      ? "Lead side a touch higher"
      : "Level";
const aimText =
  Math.abs(i.aim) < 1 ? "At the target" : i.aim < 0 ? "A little {left}" : "A little {right}";

const hands = [
  { cls: "hand-r", mirror: false },
  { cls: "hand-l", mirror: true },
];
const r = (n: number) => Math.round(n * 10) / 10;

/** x for the lead side (−1) … trail side (1) of a box `width` wide, flipped for left-handers. */
const side = (t: number, width: number, mirror: boolean) =>
  r(width / 2 + (mirror ? -t : t) * (width / 2));

// Shoulders and ground, as seen from behind the golfer: lead side on the same side as above.
const line = (deg: number, len: number, cy: number, mirror: boolean) => {
  const dx = Math.cos((deg * Math.PI) / 180) * len;
  const dy = Math.sin((deg * Math.PI) / 180) * len;
  const lead = mirror ? 1 : -1;
  return { x1: r(65 + lead * dx), y1: r(cy - dy), x2: r(65 - lead * dx), y2: r(cy + dy) };
};
---

<div class="mb-4">
  <p class="mb-2 text-sm text-ink-muted">
    Lead side on the <Handed text="{left}" />. Dashed: a normal shot.
  </p>
  <div class="grid grid-cols-2 gap-2.5">
    <div class="col-span-2 rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Address</h3>
      <p class="font-semibold text-ink-strong">{addressText}</p>
      {hands.map(({ cls, mirror }) => {
        const l = addressLayout(i, mirror);
        const { y, h } = l.foot;
        return (
          <svg
            class={`${cls} mt-1 h-auto w-full align-top`}
            viewBox={`0 0 ${ADDRESS_W} ${ADDRESS_H}`}
            aria-hidden="true"
          >
            <line
              x1={l.line.x1}
              y1={l.ballY}
              x2={l.line.x2}
              y2={l.ballY}
              class="stroke-line-strong"
              stroke-width="1.4"
              stroke-dasharray="2 4"
            />
            <text
              x={l.target.x}
              y={l.ballY - 9}
              text-anchor={l.target.anchor}
              font-size="11"
              font-weight="600"
              class="fill-accent"
            >
              {l.target.text}
            </text>
            {l.normalFeet.map((x) => (
              <path
                d={foot(x, y, h)}
                fill="none"
                class="stroke-line-strong"
                stroke-width="1.4"
                stroke-dasharray="3 2"
              />
            ))}
            {l.feet.map((f) => (
              <>
                <path d={foot(f.x, y, h)} class="fill-card stroke-ink-strong" stroke-width="1.8" />
                <path d={foot(f.x, y, h)} class="fill-accent" fill-opacity={f.shade} />
                <text
                  x={f.x}
                  y={l.labelY}
                  text-anchor="middle"
                  font-size="11"
                  class="fill-ink-muted"
                >
                  {f.label}
                </text>
              </>
            ))}
            <line
              x1={l.ball}
              y1={l.guide.y1}
              x2={l.ball}
              y2={l.guide.y2}
              class="stroke-ink-strong"
              stroke-width="1"
              stroke-dasharray="1 3"
            />
            <circle
              cx={l.normalBall}
              cy={l.ballY}
              r="8"
              fill="none"
              class="stroke-line-strong"
              stroke-width="1.6"
              stroke-dasharray="3 2"
            />
            <circle
              cx={l.ball}
              cy={l.ballY}
              r="8"
              class="fill-card stroke-ink-strong"
              stroke-width="2"
            />
            <line
              x1={l.balance.x1}
              y1={l.balance.y}
              x2={l.balance.x2}
              y2={l.balance.y}
              class="stroke-line-strong"
              stroke-width="3"
              stroke-linecap="round"
            />
            <line
              x1={l.balance.centre}
              y1={l.balance.y - 4}
              x2={l.balance.centre}
              y2={l.balance.y + 4}
              class="stroke-line-strong"
              stroke-width="1.4"
            />
            <path d={l.balance.pointer} class="fill-accent" />
          </svg>
        );
      })}
    </div>

    <div class="rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Shoulders</h3>
      <p class="leading-tight font-semibold text-ink-strong">{shoulderText}</p>
      {hands.map(({ cls, mirror }) => {
        const ground = line(scene.terrain.slopeAlong, 62, 50, mirror);
        const sh = line(setup.shoulderTilt, 46, 22, mirror);
        return (
          <svg
            class={`${cls} mt-1.5 h-auto w-full align-top`}
            viewBox="0 0 130 64"
            aria-hidden="true"
          >
            <line {...ground} class="stroke-line-strong" stroke-width="5" stroke-linecap="round" />
            <line {...sh} class="stroke-accent" stroke-width="3" stroke-linecap="round" />
            <circle cx={sh.x1} cy={sh.y1} r="4" class="fill-accent" />
            <circle cx={sh.x2} cy={sh.y2} r="4" class="fill-accent" />
            <text
              x={sh.x1}
              y={sh.y1 - 8}
              font-size="10"
              text-anchor="middle"
              class="fill-ink-muted"
            >
              Lead
            </text>
            <text
              x={sh.x2}
              y={sh.y2 - 8}
              font-size="10"
              text-anchor="middle"
              class="fill-ink-muted"
            >
              Trail
            </text>
          </svg>
        );
      })}
    </div>

    <div class="rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Aim</h3>
      <p class="leading-tight font-semibold text-ink-strong">
        <Handed text={aimText} />
      </p>
      {hands.map(({ cls, mirror }) => {
        // The target line runs toward the lead side. Aiming left of it, for a right-hander,
        // points toward the golfer's side of the line (down); mirrored for left-handers.
        const ballX = side(0.55, 130, mirror);
        const targetX = side(-0.9, 130, mirror);
        const toward = mirror ? 1 : -1;
        const a = (i.aim * 3 * Math.PI) / 180;
        const len = 62;
        const x2 = r(ballX + toward * Math.cos(a) * len);
        const y2 = r(14 - Math.sin(a) * len);
        return (
          <svg
            class={`${cls} mt-1.5 h-auto w-full align-top`}
            viewBox="0 0 130 52"
            aria-hidden="true"
          >
            <line
              x1={ballX}
              y1="14"
              x2={targetX}
              y2="14"
              class="stroke-line-strong"
              stroke-width="1.4"
              stroke-dasharray="2 3"
            />
            <circle cx={targetX} cy="14" r="3.5" class="fill-highlight" />
            <line
              x1={ballX}
              y1="14"
              x2={x2}
              y2={y2}
              class="stroke-accent"
              stroke-width="2.6"
              stroke-linecap="round"
            />
            <circle cx={x2} cy={y2} r="3.5" class="fill-accent" />
            <circle
              cx={ballX}
              cy="14"
              r="4"
              class="fill-card stroke-ink-strong"
              stroke-width="1.5"
            />
            <path d={foot(ballX - 14, 38, 22)} class="fill-line-strong" />
            <path d={foot(ballX + 14, 38, 22)} class="fill-line-strong" />
          </svg>
        );
      })}
    </div>
  </div>
</div>
