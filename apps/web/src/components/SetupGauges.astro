---
// Address position at a glance, drawn from the situation's scene and compared with a normal shot
// with the same club (dashed). Every gauge uses the golfer's own view: feet seen from above with
// the toes pointing up and the ball in front of them, so the lead side and the target are on the
// left for a right-hander and on the right for a left-hander. Both hands are drawn and global.css
// shows the reader's.
import { setupInsight, type ShotScene } from "@shotbook/shot-viz";
import Handed from "./Handed.astro";

interface Props {
  scene: ShotScene;
}

const { scene } = Astro.props;
const i = setupInsight(scene);
const { setup, normal } = i;

const ballText = { less: "Back of normal", normal: "Normal", more: "Forward of normal" }[
  i.ballPosition
];
const weightText = { lead: "More on lead foot", even: "Even", trail: "More on trail foot" }[
  i.weight
];
const shoulderText = i.matchesSlope
  ? "Match the slope"
  : setup.shoulderTilt > 7
    ? "Lead shoulder higher"
    : setup.shoulderTilt >= 2
      ? "Lead side a touch higher"
      : "Level";
const stanceText = { narrow: "Narrow", normal: "Normal", wide: "Wide" }[i.stance];
const aimText =
  Math.abs(i.aim) < 1 ? "At the target" : i.aim < 0 ? "A little {left}" : "A little {right}";

const hands = [
  { cls: "hand-r", mirror: false },
  { cls: "hand-l", mirror: true },
];
const r = (n: number) => Math.round(n * 10) / 10;

/** A shoe sole seen from above, toes up, centred on (cx, cy), `h` tall. */
const foot = (cx: number, cy: number, h: number) => {
  const w = h * 0.42;
  const top = cy - h / 2;
  const bottom = cy + h / 2;
  return [
    `M${r(cx)} ${r(top)}`,
    `C${r(cx + w * 0.62)} ${r(top)} ${r(cx + w * 0.55)} ${r(cy - h * 0.05)} ${r(cx + w * 0.36)} ${r(cy + h * 0.12)}`,
    `C${r(cx + w * 0.3)} ${r(cy + h * 0.25)} ${r(cx + w * 0.36)} ${r(bottom)} ${r(cx)} ${r(bottom)}`,
    `C${r(cx - w * 0.36)} ${r(bottom)} ${r(cx - w * 0.3)} ${r(cy + h * 0.25)} ${r(cx - w * 0.36)} ${r(cy + h * 0.12)}`,
    `C${r(cx - w * 0.55)} ${r(cy - h * 0.05)} ${r(cx - w * 0.62)} ${r(top)} ${r(cx)} ${r(top)}Z`,
  ].join(" ");
};
/** x for the lead side (−1) … trail side (1) of a box `width` wide, flipped for left-handers. */
const side = (t: number, width: number, mirror: boolean) =>
  r(width / 2 + (mirror ? -t : t) * (width / 2));

// Ball position: −1 trail foot … 1 lead heel, in front of the toes.
const ballX = (v: number, mirror: boolean) => side(-v * 0.6, 300, mirror);
const ballLead = (mirror: boolean) => side(-0.6, 300, mirror);
const ballTrail = (mirror: boolean) => side(0.6, 300, mirror);

// Shoulders and ground, as seen from behind the golfer: lead side on the same side as above.
const line = (deg: number, len: number, cy: number, mirror: boolean) => {
  const dx = Math.cos((deg * Math.PI) / 180) * len;
  const dy = Math.sin((deg * Math.PI) / 180) * len;
  const lead = mirror ? 1 : -1;
  return { x1: r(65 + lead * dx), y1: r(cy - dy), x2: r(65 - lead * dx), y2: r(cy + dy) };
};

const stanceHalf = (w: number) => r(w * 110);
---

<div class="mb-4">
  <p class="mb-2 text-sm text-ink-muted">
    From above, toes pointing up, lead side on the <Handed text="{left}" />. Dashed: a normal shot.
  </p>
  <div class="grid grid-cols-2 gap-2.5">
    <div class="col-span-2 rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Ball position</h3>
      <p class="font-semibold text-ink-strong">{ballText}</p>
      {hands.map(({ cls, mirror }) => (
        <svg class={`${cls} mt-1 h-auto w-full align-top`} viewBox="0 0 300 96" aria-hidden="true">
          <line
            x1={ballLead(mirror)}
            y1="16"
            x2={ballTrail(mirror)}
            y2="16"
            class="stroke-line-strong"
            stroke-width="1.5"
            stroke-dasharray="2 4"
          />
          <path
            d={foot(ballLead(mirror), 56, 44)}
            class="fill-card stroke-line-strong"
            stroke-width="1.5"
          />
          <path
            d={foot(ballTrail(mirror), 56, 44)}
            class="fill-card stroke-line-strong"
            stroke-width="1.5"
          />
          <circle
            cx={ballX(normal.ballPosition, mirror)}
            cy="16"
            r="8"
            fill="none"
            class="stroke-line-strong"
            stroke-width="1.6"
            stroke-dasharray="3 2"
          />
          <circle
            cx={ballX(setup.ballPosition, mirror)}
            cy="16"
            r="8"
            class="fill-card stroke-ink-strong"
            stroke-width="2"
          />
          <text
            x={ballLead(mirror)}
            y="93"
            text-anchor="middle"
            font-size="11"
            class="fill-ink-muted"
          >
            Lead
          </text>
          <text
            x={ballTrail(mirror)}
            y="93"
            text-anchor="middle"
            font-size="11"
            class="fill-ink-muted"
          >
            Trail
          </text>
          <text
            x={mirror ? 298 : 2}
            y="20"
            text-anchor={mirror ? "end" : "start"}
            font-size="11"
            font-weight="600"
            class="fill-accent"
          >
            {mirror ? "Target →" : "← Target"}
          </text>
        </svg>
      ))}
    </div>

    <div class="rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Weight</h3>
      <p class="leading-tight font-semibold text-ink-strong">{weightText}</p>
      {hands.map(({ cls, mirror }) => (
        <svg
          class={`${cls} mt-1.5 h-auto w-full align-top`}
          viewBox="0 0 130 64"
          aria-hidden="true"
        >
          {[
            { t: -0.5, share: setup.weightLead, label: "Lead" },
            { t: 0.5, share: 1 - setup.weightLead, label: "Trail" },
          ].map(({ t, share, label }) => (
            <>
              <path
                d={foot(side(t, 130, mirror), 26, 44)}
                class="fill-card stroke-line-strong"
                stroke-width="1.5"
              />
              <path
                d={foot(side(t, 130, mirror), 26, 44)}
                class="fill-accent"
                fill-opacity={r(Math.min(1, Math.max(0.1, (share - 0.2) * 1.6)))}
              />
              <text
                x={side(t, 130, mirror)}
                y="62"
                text-anchor="middle"
                font-size="10"
                class="fill-ink-muted"
              >
                {label}
              </text>
            </>
          ))}
        </svg>
      ))}
    </div>

    <div class="rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Shoulders</h3>
      <p class="leading-tight font-semibold text-ink-strong">{shoulderText}</p>
      {hands.map(({ cls, mirror }) => {
        const ground = line(scene.terrain.slopeAlong, 62, 50, mirror);
        const sh = line(setup.shoulderTilt, 46, 22, mirror);
        return (
          <svg
            class={`${cls} mt-1.5 h-auto w-full align-top`}
            viewBox="0 0 130 64"
            aria-hidden="true"
          >
            <line {...ground} class="stroke-line-strong" stroke-width="5" stroke-linecap="round" />
            <line {...sh} class="stroke-accent" stroke-width="3" stroke-linecap="round" />
            <circle cx={sh.x1} cy={sh.y1} r="4" class="fill-accent" />
            <circle cx={sh.x2} cy={sh.y2} r="4" class="fill-accent" />
            <text
              x={sh.x1}
              y={sh.y1 - 8}
              font-size="10"
              text-anchor="middle"
              class="fill-ink-muted"
            >
              Lead
            </text>
            <text
              x={sh.x2}
              y={sh.y2 - 8}
              font-size="10"
              text-anchor="middle"
              class="fill-ink-muted"
            >
              Trail
            </text>
          </svg>
        );
      })}
    </div>

    <div class="rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Stance</h3>
      <p class="leading-tight font-semibold text-ink-strong">{stanceText}</p>
      <svg class="mt-1.5 block h-auto w-full" viewBox="0 0 130 52" aria-hidden="true">
        {[-1, 1].map((s) => (
          <>
            <path
              d={foot(65 + s * stanceHalf(normal.stanceWidth), 26, 40)}
              fill="none"
              class="stroke-line-strong"
              stroke-width="1.4"
              stroke-dasharray="3 2"
            />
            <path
              d={foot(65 + s * stanceHalf(setup.stanceWidth), 26, 40)}
              class="fill-ink-strong"
            />
          </>
        ))}
      </svg>
    </div>

    <div class="rounded-lg bg-surface px-3 pt-2.5 pb-2">
      <h3 class="text-xs font-semibold tracking-widest text-ink-muted uppercase">Aim</h3>
      <p class="leading-tight font-semibold text-ink-strong">
        <Handed text={aimText} />
      </p>
      {hands.map(({ cls, mirror }) => {
        // The target line runs toward the lead side. Aiming left of it, for a right-hander,
        // points toward the golfer's side of the line (down); mirrored for left-handers.
        const ballX = side(0.55, 130, mirror);
        const targetX = side(-0.9, 130, mirror);
        const toward = mirror ? 1 : -1;
        const a = (i.aim * 3 * Math.PI) / 180;
        const len = 62;
        const x2 = r(ballX + toward * Math.cos(a) * len);
        const y2 = r(14 - Math.sin(a) * len);
        return (
          <svg
            class={`${cls} mt-1.5 h-auto w-full align-top`}
            viewBox="0 0 130 52"
            aria-hidden="true"
          >
            <line
              x1={ballX}
              y1="14"
              x2={targetX}
              y2="14"
              class="stroke-line-strong"
              stroke-width="1.4"
              stroke-dasharray="2 3"
            />
            <circle cx={targetX} cy="14" r="3.5" class="fill-highlight" />
            <line
              x1={ballX}
              y1="14"
              x2={x2}
              y2={y2}
              class="stroke-accent"
              stroke-width="2.6"
              stroke-linecap="round"
            />
            <circle cx={x2} cy={y2} r="3.5" class="fill-accent" />
            <circle
              cx={ballX}
              cy="14"
              r="4"
              class="fill-card stroke-ink-strong"
              stroke-width="1.5"
            />
            <path d={foot(ballX - 14, 38, 22)} class="fill-line-strong" />
            <path d={foot(ballX + 14, 38, 22)} class="fill-line-strong" />
          </svg>
        );
      })}
    </div>
  </div>
</div>
