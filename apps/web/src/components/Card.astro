---
interface Props {
  title: string;
  tone?: "default" | "warning" | "muted";
}

const { title, tone = "default" } = Astro.props;
// Tone colours the heading and the bullet markers.
const toneClass = {
  default: "[--tone:var(--color-accent)]",
  warning: "[--tone:var(--color-highlight)]",
  muted: "[--tone:var(--color-line-strong)]",
}[tone];
---

<section class={`rounded-card border border-line bg-card p-4 shadow-card ${toneClass}`}>
  <h2
    class={`mb-3 text-xs font-semibold uppercase tracking-widest ${tone === "muted" ? "text-ink-muted" : "text-(--tone)"}`}
  >
    {title}
  </h2>
  <div class="text-lg leading-snug marker:text-(--tone)">
    <slot />
  </div>
</section>
