---
interface Props {
  title: string;
  tone?: "default" | "warning" | "muted";
}

const { title, tone = "default" } = Astro.props;
const accent = {
  default: "border-l-fairway-600",
  warning: "border-l-amber-500",
  muted: "border-l-stone-400",
}[tone];
---

<section class={`rounded-2xl border border-stone-300 border-l-8 bg-white p-4 shadow-sm ${accent}`}>
  <h2 class="mb-2 text-sm font-bold uppercase tracking-wider text-stone-700">{title}</h2>
  <div class="text-lg leading-snug">
    <slot />
  </div>
</section>
