---
// Global right/left-handed switch.
import PrefToggle from "./PrefToggle.astro";

interface Props {
  wide?: boolean;
}
---

<PrefToggle
  pref="hand"
  label="Which way do you swing?"
  title="Directions in the advice follow this setting"
  wide={Astro.props.wide}
  options={[
    { value: "right", label: "Right", srSuffix: "-handed" },
    { value: "left", label: "Left", srSuffix: "-handed" },
  ]}
/>
