---
// Saves a situation to the reader's favourites, stored on this device. Without JavaScript there
// is nowhere to keep them, so the button stays hidden until the script runs.

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<button
  type="button"
  data-favourite={id}
  hidden
  aria-pressed="false"
  class="group mt-3 inline-flex min-h-11 items-center gap-2 rounded-full border border-line-strong px-4 font-medium text-ink transition-colors hover:bg-surface aria-pressed:border-highlight"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="size-5 fill-none stroke-accent group-aria-pressed:fill-highlight group-aria-pressed:stroke-highlight"
    stroke-width="2"
    stroke-linejoin="round"
  >
    <path d="M12 20s-7.5-4.6-7.5-10A4.5 4.5 0 0 1 12 7.2 4.5 4.5 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"></path>
  </svg>
  <span class="group-aria-pressed:hidden">Save to favourites</span>
  <span class="hidden group-aria-pressed:inline">Saved to favourites</span>
</button>

<script>
  import { FAVOURITES_KEY, parseFavourites, toggleFavourite } from "@shotbook/content/favourites";

  const read = () => {
    try {
      return parseFavourites(localStorage.getItem(FAVOURITES_KEY));
    } catch {
      return [];
    }
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-favourite]")) {
    const id = button.dataset.favourite!;
    const sync = () => button.setAttribute("aria-pressed", String(read().includes(id)));
    button.addEventListener("click", () => {
      try {
        localStorage.setItem(FAVOURITES_KEY, JSON.stringify(toggleFavourite(read(), id)));
      } catch {
        // Storage unavailable (private mode): nothing to save to.
        return;
      }
      sync();
    });
    // Another tab may change favourites while this one is open.
    addEventListener("storage", (e) => {
      if (e.key === FAVOURITES_KEY) sync();
    });
    sync();
    button.hidden = false;
  }
</script>
