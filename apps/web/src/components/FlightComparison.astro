---
// What the ball does compared with a normal shot with the same club: three effect tiles, the
// flight side-on over a dashed normal shot, and the curve from above when there is one. Both
// flights are scaled to the same length so a chip and a full shot compare by shape. No numbers.
import {
  CLUB_SPECS,
  compareWithNormal,
  type FlightResult,
  type ShotScene,
} from "@shotbook/shot-viz";
import Handed from "./Handed.astro";

interface Props {
  scene: ShotScene;
}

const { scene } = Astro.props;
const c = compareWithNormal(scene);
const club = CLUB_SPECS[scene.swing.club].label.toLowerCase();

const r = (n: number) => Math.round(n * 10) / 10;
const points = (f: FlightResult) => [...f.air, ...f.roll].map((s) => s.p);

// Side-on: distance along the shot against height above the line from start to rest.
const W = 300;
const BASE = 96;
const sideShape = (f: FlightResult) => {
  const pts = points(f);
  const end = pts[pts.length - 1]!;
  return pts.map(([x, y]) => [x / f.total, (y - (x / f.total) * end[1]) / f.total] as const);
};
const thisShape = sideShape(c.flight);
const normalShape = sideShape(c.normal);
const maxY = Math.max(...thisShape.map((p) => p[1]), ...normalShape.map((p) => p[1]));
const sx = (x: number) => r(12 + x * (W - 24));
const sy = (y: number) => r(BASE - (Math.max(0, y) / maxY) * (BASE - 10));
const pathOf = (shape: ReadonlyArray<readonly [number, number]>) =>
  shape.map(([x, y], n) => `${n ? "L" : "M"}${sx(x)} ${sy(y)}`).join(" ");
const landX = sx(c.flight.carry / c.flight.total);

// From above: sideways movement, exaggerated so the curve reads on a phone.
const zs = points(c.flight).map((p) => p[2]);
const zMax = Math.max(...zs.map(Math.abs), 0.1);
const topPath = (mirror: boolean) =>
  points(c.flight)
    .map(
      ([x, , z], n) =>
        `${n ? "L" : "M"}${sx(x / c.flight.total)} ${r(30 + ((mirror ? -z : z) / zMax) * 18)}`,
    )
    .join(" ");

const height = { less: "Lower flight", normal: "Normal height", more: "Higher flight" }[c.height];
const roll = {
  less: "Less roll",
  normal: "Normal roll",
  more: "More roll",
  "much-more": "Much more roll",
}[c.roll];
const curve = { left: "Curves {left}", none: "Straight", right: "Curves {right}" }[c.curve];

// Effect icons, drawn small.
const heightCtrl = { less: 16, normal: 4, more: -8 }[c.height];
const rollLen = { less: 2, normal: 5, more: 10, "much-more": 15 }[c.roll];
const curveEnd = (mirror: boolean) => {
  const side = c.curve === "none" ? 0 : (c.curve === "right") !== mirror ? 1 : -1;
  return { end: 17 + side * 8, ctrl: 17 - side * 6 };
};
const tile = "rounded-lg bg-surface px-1.5 py-2 text-center text-sm leading-tight";
const strong = (k: string) =>
  k === "normal" || k === "none" ? "text-ink-muted" : "font-semibold text-ink-strong";
---

<div class="mb-4">
  <div class="mb-3 grid grid-cols-3 gap-2">
    <div class={`${tile} ${strong(c.height)}`}>
      <svg class="mx-auto mb-1 h-9 w-9" viewBox="0 0 34 34" aria-hidden="true">
        <path
          d="M3 28 Q17 4 31 28"
          fill="none"
          class="stroke-line-strong"
          stroke-width="1.6"
          stroke-dasharray="3 3"
        />
        <path
          d={`M3 28 Q17 ${heightCtrl} 31 28`}
          fill="none"
          class="stroke-accent"
          stroke-width="2.6"
          stroke-linecap="round"
        />
        <line x1="1" y1="29.5" x2="33" y2="29.5" class="stroke-line-strong" stroke-width="1.5" />
      </svg>
      {height}
    </div>
    <div class={`${tile} ${strong(c.roll)}`}>
      <svg class="mx-auto mb-1 h-9 w-9" viewBox="0 0 34 34" aria-hidden="true">
        <path
          d={`M2 28 Q${r((28 - rollLen) / 2 + 1)} 6 ${28 - rollLen} 28`}
          fill="none"
          class="stroke-accent"
          stroke-width="2.2"
          stroke-linecap="round"
        />
        <line
          x1={28 - rollLen}
          y1="28"
          x2="28"
          y2="28"
          class="stroke-accent"
          stroke-width="3.6"
          stroke-linecap="round"
        />
        <circle cx="30" cy="26.5" r="2.4" class="fill-ink-strong" />
        <line x1="1" y1="30.5" x2="33" y2="30.5" class="stroke-line-strong" stroke-width="1.5" />
      </svg>
      {roll}
    </div>
    <div class={`${tile} ${strong(c.curve)}`}>
      {[false, true].map((mirror) => {
        const { end, ctrl } = curveEnd(mirror);
        return (
          <svg
            class={`${mirror ? "hand-l" : "hand-r"} mx-auto mb-1 h-9 w-9`}
            viewBox="0 0 34 34"
            aria-hidden="true"
          >
            <line
              x1="17"
              y1="31"
              x2="17"
              y2="3"
              class="stroke-line-strong"
              stroke-width="1.4"
              stroke-dasharray="2 3"
            />
            <path
              d={`M17 31 Q${ctrl} 12 ${end} 5`}
              fill="none"
              class="stroke-accent"
              stroke-width="2.6"
              stroke-linecap="round"
            />
            <circle cx="17" cy="4" r="2.4" class="fill-highlight" />
          </svg>
        );
      })}
      <Handed text={curve} />
    </div>
  </div>

  <svg class="h-auto w-full" viewBox={`0 0 ${W} 112`} aria-hidden="true">
    <rect x="0" y={BASE} width={W} height={112 - BASE} class="fill-accent-soft" />
    <path
      d={pathOf(normalShape)}
      fill="none"
      class="stroke-line-strong"
      stroke-width="2"
      stroke-dasharray="4 4"
    />
    <path
      d={pathOf(thisShape)}
      fill="none"
      class="stroke-accent"
      stroke-width="3"
      stroke-linecap="round"
    />
    <line
      x1={landX}
      y1={BASE}
      x2={sx(1)}
      y2={BASE}
      class="stroke-accent"
      stroke-width="6"
      stroke-linecap="round"
    />
    <circle cx={sx(0)} cy={BASE - 4} r="3.5" class="fill-ink-strong" />
    <circle
      cx={sx(1)}
      cy={BASE - 4}
      r="4.5"
      class="fill-card stroke-ink-strong"
      stroke-width="1.8"
    />
    <text x={landX} y={BASE + 13} font-size="10" text-anchor="middle" class="fill-ink-muted">
      lands
    </text>
  </svg>
  <p class="mt-1 flex flex-wrap gap-x-4 text-sm text-ink-muted">
    <span class="inline-flex items-center gap-1.5">
      <span class="w-5 border-t-[3px] border-accent"></span>This shot
    </span>
    <span class="inline-flex items-center gap-1.5">
      <span class="w-5 border-t-2 border-dashed border-line-strong"></span>Normal {club} shot
    </span>
  </p>

  {c.curve !== "none" && (
    <>
      <h3 class="mt-3 mb-1 text-xs font-semibold tracking-widest text-ink-muted uppercase">
        From above
      </h3>
      {[false, true].map((mirror) => (
        <svg
          class={`${mirror ? "hand-l" : "hand-r"} h-auto w-full`}
          viewBox={`0 0 ${W} 60`}
          aria-hidden="true"
        >
          <rect x="0" y="0" width={W} height="60" rx="6" class="fill-surface" />
          <line
            x1="12"
            y1="30"
            x2={W - 12}
            y2="30"
            class="stroke-line-strong"
            stroke-width="1.4"
            stroke-dasharray="3 4"
          />
          <circle cx={W - 12} cy="30" r="4" class="fill-highlight" />
          <path
            d={topPath(mirror)}
            fill="none"
            class="stroke-accent"
            stroke-width="3"
            stroke-linecap="round"
          />
          <text x="16" y="13" font-size="10" class="fill-ink-muted">
            left
          </text>
          <text x="16" y="54" font-size="10" class="fill-ink-muted">
            right
          </text>
        </svg>
      ))}
    </>
  )}
</div>
