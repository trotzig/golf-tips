---
// Around the green, less loft means less air and more roll. One row per club: a dashed carry
// arc, then the roll. Rule-of-thumb shapes, drawn without numbers.
const CLUBS = [
  ["SW", "Sand wedge", 1],
  ["PW", "Pitching wedge", 2],
  ["9-iron", "9-iron", 3],
  ["8-iron", "8-iron", 4],
  ["7-iron", "7-iron", 5],
] as const;
const r = (n: number) => Math.round(n * 10) / 10;
---

<p class="sr-only">
  The less loft, the more the ball rolls: a sand wedge flies furthest and rolls least, a 7-iron
  flies least and rolls most.
</p>
<div class="mb-3 grid gap-1" aria-hidden="true">
  {CLUBS.map(([short, , roll]) => {
    const air = r((206 / (roll + 1)) * 1.3);
    return (
      <div class="grid grid-cols-[3.5rem_1fr] items-center gap-2 rounded-lg px-2 py-1 text-sm font-semibold text-ink-strong">
        {short}
        <svg class="h-auto w-full" viewBox="0 0 220 26">
          <path
            d={`M4 22 Q${r(4 + air / 2)} 4 ${r(4 + air)} 22`}
            fill="none"
            class="stroke-line-strong"
            stroke-width="1.6"
            stroke-dasharray="3 3"
          />
          <line
            x1={r(4 + air)}
            y1="22"
            x2="212"
            y2="22"
            class="stroke-accent"
            stroke-width="4"
            stroke-linecap="round"
          />
          <circle cx={r(4 + air)} cy="22" r="3" class="fill-ink-strong" />
        </svg>
      </div>
    );
  })}
  <div class="flex justify-between px-2 text-xs text-ink-muted">
    <span>More air</span>
    <span>More roll</span>
  </div>
</div>
