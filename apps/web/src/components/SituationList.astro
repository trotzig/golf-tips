---
import { getCategory, type Situation } from "@shotbook/content";
import { href } from "../lib/content";
import Handed from "./Handed.astro";

interface Props {
  situations: Situation[];
  showCategory?: boolean;
}

const { situations, showCategory = true } = Astro.props;
---

<ul class="space-y-3">
  {situations.map((s) => (
    <li data-situation={s.id}>
      <a
        href={href(`situations/${s.id}/`)}
        class="block rounded-card border border-line bg-card p-4 shadow-card transition hover:border-accent active:bg-accent-soft"
      >
        <span class="flex items-baseline justify-between gap-3">
          <span class="text-lg font-semibold text-ink-strong">
            <Handed text={s.title} />
          </span>
          {showCategory && (
            <span class="shrink-0 text-xs font-medium uppercase tracking-wide text-ink-muted">
              {getCategory(s.category).title}
            </span>
          )}
        </span>
        <span class="mt-1 block text-ink-muted">
          <Handed text={s.summary} />
        </span>
      </a>
    </li>
  ))}
</ul>
