---
import { getCategory, type Situation } from "@shotbook/content";
import { href } from "../lib/content";
import Handed from "./Handed.astro";

interface Props {
  situations: Situation[];
  showCategory?: boolean;
}

const { situations, showCategory = true } = Astro.props;
---

<ul class="space-y-3">
  {situations.map((s) => (
    <li>
      <a
        href={href(`situations/${s.id}/`)}
        class="block rounded-2xl border border-stone-300 bg-white p-4 shadow-sm transition hover:border-fairway-600 active:bg-fairway-50"
      >
        <span class="flex items-baseline justify-between gap-3">
          <span class="text-lg font-semibold text-fairway-800">
            <Handed text={s.title} />
          </span>
          {showCategory && (
            <span class="shrink-0 text-xs font-medium uppercase tracking-wide text-stone-600">
              {getCategory(s.category).title}
            </span>
          )}
        </span>
        <span class="mt-1 block text-stone-700">
          <Handed text={s.summary} />
        </span>
      </a>
    </li>
  ))}
</ul>
