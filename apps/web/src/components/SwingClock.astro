---
// How far back to swing, as a clock face seen face-on: a right-hander's club goes back up the
// left side (6 → 9 → 12), a left-hander's up the right. Dashed: a full swing.
import type { ShotScene, SwingLength } from "@shotbook/shot-viz";

interface Props {
  scene: ShotScene;
}

const { scene } = Astro.props;
const { length, attackAngle } = scene.swing;

// Where the club points at the top, in clock hours.
const TOP: Record<SwingLength, number> = { quarter: 8, half: 9, "three-quarter": 10.5, full: 12.3 };
const NAME: Record<SwingLength, string> = {
  quarter: "Quarter swing",
  half: "Half swing",
  "three-quarter": "Three-quarter swing",
  full: "Full swing",
};

const r = (n: number) => Math.round(n * 10) / 10;
const point = (hour: number, radius: number, mirror: boolean) => {
  const a = ((hour / 12) * 360 - 90) * (Math.PI / 180);
  const x = Math.cos(a) * radius;
  return [r(56 + (mirror ? -x : x)), r(56 + Math.sin(a) * radius)] as const;
};
const arc = (to: number, mirror: boolean) => {
  const [sx, sy] = point(6, 40, mirror);
  const [ex, ey] = point(to, 40, mirror);
  const large = to - 6 > 6 ? 1 : 0;
  return `M${sx} ${sy} A40 40 0 ${large} ${mirror ? 0 : 1} ${ex} ${ey}`;
};
const hitDown = attackAngle !== undefined && attackAngle <= -3;
---

<div class="mb-4 grid grid-cols-[112px_1fr] items-center gap-4">
  {[false, true].map((mirror) => {
    const [ex, ey] = point(TOP[length], 40, mirror);
    return (
      <svg
        class={`${mirror ? "hand-l" : "hand-r"} col-start-1 row-start-1 h-28 w-28`}
        viewBox="0 0 112 112"
        aria-hidden="true"
      >
        <circle cx="56" cy="56" r="52" class="fill-surface" />
        {[12, 3, 6, 9].map((h) => {
          const [x1, y1] = point(h, 47, mirror);
          const [x2, y2] = point(h, 52, mirror);
          return <line {...{ x1, y1, x2, y2 }} class="stroke-line-strong" stroke-width="2" />;
        })}
        <path
          d={arc(12.3, mirror)}
          fill="none"
          class="stroke-line-strong"
          stroke-width="2"
          stroke-dasharray="3 3"
        />
        <path
          d={arc(TOP[length], mirror)}
          fill="none"
          class="stroke-accent"
          stroke-width="6"
          stroke-linecap="round"
        />
        <line x1="56" y1="56" x2={ex} y2={ey} class="stroke-ink-strong" stroke-width="2" />
        <circle cx="56" cy="56" r="4" class="fill-ink-strong" />
        <circle cx={ex} cy={ey} r="5" class="fill-ink-strong" />
      </svg>
    );
  })}
  <div class="col-start-2 row-start-1">
    <p class="text-lg font-semibold text-ink-strong">{NAME[length]}</p>
    {hitDown && <p class="leading-snug text-ink-muted">Hit down: ball first, then the ground.</p>}
  </div>
</div>
