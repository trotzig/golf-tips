---
import "../styles/global.css";
import HandToggle from "../components/HandToggle.astro";
import { href } from "../lib/content";
import { defaultHand } from "../lib/handed";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = "How to play every golf shot and situation, on one card." } =
  Astro.props;
const fullTitle = title ? `${title} · Shotbook` : "Shotbook — how do I play this shot?";
---

<!doctype html>
<html lang="en" data-hand="right">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={defaultHand(description)} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b201e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={href("favicon.svg")} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{defaultHand(fullTitle)}</title>
    <script is:inline>
      // Apply the saved handedness before first paint so directions never flicker.
      try {
        if (localStorage.getItem("shotbook:hand") === "left")
          document.documentElement.dataset.hand = "left";
      } catch {
        // Storage unavailable: stay right-handed.
      }
    </script>
  </head>
  <body class="min-h-dvh bg-canvas font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:rounded-card focus:bg-card focus:p-3"
    >
      Skip to content
    </a>
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-2xl items-center justify-between gap-3 px-4 py-3">
        <a
          href={href("/")}
          class="flex items-center gap-2 py-1 text-lg font-semibold tracking-wide text-ink-strong"
        >
          <svg aria-hidden="true" viewBox="0 0 32 32" class="size-7 rounded-md">
            <rect width="32" height="32" class="fill-accent"></rect>
            <circle cx="16" cy="17" r="8" fill="#fff"></circle>
            <g fill="#c9d3ce">
              <circle cx="13.5" cy="14.5" r="1"></circle>
              <circle cx="17" cy="14" r="1"></circle>
              <circle cx="15" cy="18" r="1"></circle>
              <circle cx="18.5" cy="17.5" r="1"></circle>
            </g>
          </svg>
          Shotbook
        </a>
        <div class="flex items-center gap-1 rounded-tray bg-surface p-1">
          <a
            href={href("search/")}
            class="flex size-10 items-center justify-center rounded-[10px] text-ink transition-colors hover:bg-raised hover:text-accent"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
            >
              <circle cx="10.5" cy="10.5" r="6.5"></circle>
              <path d="m15.5 15.5 5 5"></path>
            </svg>
            <span class="sr-only">Search</span>
          </a>
          <HandToggle />
        </div>
      </div>
    </header>
    <main id="main" class="mx-auto max-w-2xl px-4 pb-16 pt-6">
      <slot />
    </main>
    <footer class="mx-auto max-w-2xl border-t border-line px-4 pb-10 pt-6 text-sm text-ink-muted">
      Mainstream advice for every level. Practice it on the range before trusting it on the course.
    </footer>
  </body>
</html>
